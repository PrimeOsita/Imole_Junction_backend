NODE_ENV=development
PORT=Desired port number
MONGO_URI= MongoDB connection string
REDIS_HOST= Redis host
REDIS_PORT= Redis port
CHILD_TOKEN_SECRET= Child token secret
PARENT_JWT_SECRET= Parent JWT secret
ADMIN_JWT_SECRET= Admin JWT secret
JWT_EXPIRES_IN= JWT expiration duration (e.g., 7d for 7 days)
ADMIN_SEED_EMAIL= Admin seed email
ADMIN_SEED_PASSWORD= Admin seed password
SUBMIT_RATE_LIMIT_MAX= Submit rate limit max
SUBMIT_RATE_LIMIT_WINDOW_MINUTES= Submit rate limit window in minutes
BREVO_API_KEY= Your Brevo API key
BREVO_SENDER_NAME= IMOLE
# Use an email address verified as a sender in your Brevo account.
BREVO_SENDER_EMAIL= Verified sender email
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=
# Create a separate recurring plan for each interval in Flutterwave.
FLW_PREMIUM_MONTHLY_PLAN_ID=
FLW_PREMIUM_MONTHLY_AMOUNT=
FLW_PREMIUM_YEARLY_PLAN_ID=
FLW_PREMIUM_YEARLY_AMOUNT=
# Legacy single-plan settings; use the interval setting only for older deployments.
FLW_PREMIUM_PLAN_ID=
FLW_PREMIUM_AMOUNT=
FLW_PREMIUM_INTERVAL=monthly
# Public frontend URL to receive Flutterwave's checkout redirect.
FLW_REDIRECT_URL=